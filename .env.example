# Embeddings: minilm (sentence-transformers all-MiniLM-L6-v2) | hashing (deterministic, no download)
RAG_EMBEDDINGS=minilm
# Leave empty for an in-memory index; set a path to persist Chroma on disk
RAG_PERSIST_DIR=

# LLM: fake (extractive stand-in, no key) | openai (any OpenAI-compatible server) | anthropic
RAG_LLM_PROVIDER=fake
RAG_LLM_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=

RAG_CHUNK_SIZE=400
RAG_CHUNK_OVERLAP=80
RAG_TOP_K=4
RAG_MIN_COVERAGE=0.5
